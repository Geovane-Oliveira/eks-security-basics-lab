{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PodIdentityAppS3Read",
      "Effect": "Allow",
      "Principal": { "Service": "pods.eks.amazonaws.com" },
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/eks-cluster-arn": "arn:aws:eks:${AWS_REGION}:${ACCOUNT_ID}:cluster/${CLUSTER}",
          "aws:RequestTag/kubernetes-namespace": "app",
          "aws:RequestTag/kubernetes-service-account": "app-sa"
        }
      }
    }
  ]
}
